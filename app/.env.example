# Classmate sunucu ayarları — bu dosyayı .env olarak kopyalayıp doldurun.

# Örnek (uydurma) veriyle, bilinen parolalı demo kurulumu: 1 / 0
# Tanımsızsa geliştirmede 1, üretimde (npm run start) 0 sayılır.
# 0 iken ilk açılışta boş kurum ve aşağıdaki genel yönetici oluşturulur; ILK_YONETICI_PAROLA zorunludur (parola kuralına uymalı).
# Yerelde örnek veriyle denemek için 1 yapın.
DEMO=0
KURUM_ADI=Örnek Eğitim Kurumu
ILK_YONETICI_EPOSTA=yonetim@kurum.com
ILK_YONETICI_PAROLA=
ILK_YONETICI_TELEFON=

# Veritabanı: boşsa gömülü PostgreSQL (PGlite) ./.veri/pg klasöründe çalışır.
# Canlıda gerçek PostgreSQL: postgres://kullanici:parola@sunucu:5432/classmate
DATABASE_URL=
PGLITE_DIZIN=./.veri/pg

# SMS: konsol (gönderilmez, sunucu konsoluna yazılır) veya netgsm
SMS_SAGLAYICI=konsol
NETGSM_KULLANICI=
NETGSM_SIFRE=
# Operatöre onaylatılmış gönderici adı (SMS başlığı)
NETGSM_BASLIK=

# Web push (uygulama bildirimi). Boşsa ilk açılışta üretilip veritabanında saklanır.
VAPID_PUBLIC=
VAPID_PRIVATE=
PUSH_ILETISIM=bilgi@kurum.com

# Otomatik yedek klasörü (kişisel veri içerir; yalnızca sunucu erişebilmeli). Saklama 30 gün.
YEDEK_DIZIN=./.veri/yedekler

PORT=3001
# Kurum saat dilimi (sunucu başka bölgede olsa da)
TZ=Europe/Istanbul
